# ── Alation API ──────────────────────────────────────────────────────────────
ALATION_BASE_URL=https://proximidad.alationcloud.com
ALATION_AUTH_MODE=oauth

# Bearer token para descarga (Catalog API)
# Generar en Alation: Settings > Authentication > Create Token
ALATION_BEARER_TOKEN=

# API token para carga (Integration API)
# Generar en Alation: Settings > API > Create Token
ALATION_API_TOKEN=

# ── Rutas de datos ────────────────────────────────────────────────────────────
# Directorio base de datos, relativo a la raíz del backend
# Estructura:
#   data/
#   ├── Tables.xlsx       ← OIDs de tablas a procesar
#   ├── alation/          ← CSV descargados desde Alation
#   ├── format/           ← Excel de enriquecimiento
#   └── destination/      ← CSV generados para subir
PATH_DATA=data

# ── Otros ─────────────────────────────────────────────────────────────────────
CSV_ENCODING=UTF-8-SIG
